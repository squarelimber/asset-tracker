# Miscellaneous
*.class
*.log
.superpowers/
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Flutter tool's per-machine state file
.flutter_tool_state

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local database and backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
/backups/

# Release signing material. Never commit these: CI writes them from repository
# secrets before building (see .github/workflows/release.yml).
/android/key.properties
/android/release/*.keystore

# Local release artifacts (fallback builds; releases are built by CI)
/asset-tracker-*.apk
/asset_tracker-windows-*.zip

dist/
